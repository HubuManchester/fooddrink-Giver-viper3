<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodAndDrink.MainPage"
             Shell.NavBarIsVisible="False"
             Title="Food &amp; Drink">

    <ScrollView>
        <VerticalStackLayout Spacing="0"
                             BackgroundColor="{AppThemeBinding Light={StaticResource OffWhite},
                                                              Dark={StaticResource Black}}">

            <!-- ===== Header ===== -->
            <VerticalStackLayout Padding="28,56,28,16" Spacing="16"
                                 BackgroundColor="{StaticResource BgWarmLight}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Discover"
                               FontSize="32" FontAttributes="Bold"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                           Dark={StaticResource TextDark}}" />
                        <Label Text="Find the best food &amp; drinks near you"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                           Dark={StaticResource TextDimDark}}" />
                    </VerticalStackLayout>
                    <Frame Grid.Column="1"
                           WidthRequest="44" HeightRequest="44"
                           CornerRadius="14" Padding="0" HasShadow="False"
                           BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray100}}"
                           BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                           VerticalOptions="Center">
                        <Label Text="🔔" FontSize="18"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                </Grid>
                <SearchBar x:Name="MainSearchBar"
                           Placeholder="Search dishes, drinks, places..." />
            </VerticalStackLayout>

            <!-- ===== Content ===== -->
            <VerticalStackLayout Spacing="28" Padding="0,24,0,48">

                <!-- === Trending Now === -->
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" Padding="28,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <BoxView WidthRequest="28" HeightRequest="4"
                                     CornerRadius="2"
                                     Color="{StaticResource Primary}" />
                            <Label Text="Trending Now"
                                   Style="{StaticResource SectionTitle}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="See All"
                               FontSize="14" FontAttributes="Bold"
                               VerticalOptions="End"
                               TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                           Dark={StaticResource PrimaryDark}}" />
                    </Grid>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="14" Padding="28,0">
                            <!-- Card 1 -->
                            <Frame WidthRequest="200" HeightRequest="260" Padding="0"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                                   BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                <Grid RowDefinitions="*,Auto">
                                    <BoxView Grid.Row="0"
                                             Color="{StaticResource PrimaryLight}"
                                             CornerRadius="16,16,0,0" />
                                    <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="6">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="🔥" FontSize="14" />
                                            <Label Text=""
                                                   Style="{StaticResource CardTitle}" />
                                        </HorizontalStackLayout>
                                        <Label Text=""
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                          Dark={StaticResource TextDimDark}}" />
                                        <BoxView HeightRequest="1"
                                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                                 Margin="0,4" />
                                        <Label Text=""
                                               FontSize="13" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                                          Dark={StaticResource PrimaryDark}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                            <!-- Card 2 -->
                            <Frame WidthRequest="200" HeightRequest="260" Padding="0"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                                   BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                <Grid RowDefinitions="*,Auto">
                                    <BoxView Grid.Row="0"
                                             Color="{StaticResource SecondaryLight}"
                                             CornerRadius="16,16,0,0" />
                                    <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="6">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="🧋" FontSize="14" />
                                            <Label Text=""
                                                   Style="{StaticResource CardTitle}" />
                                        </HorizontalStackLayout>
                                        <Label Text=""
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                          Dark={StaticResource TextDimDark}}" />
                                        <BoxView HeightRequest="1"
                                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                                 Margin="0,4" />
                                        <Label Text=""
                                               FontSize="13" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Secondary},
                                                                          Dark={StaticResource SecondaryDark}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                            <!-- Card 3 -->
                            <Frame WidthRequest="200" HeightRequest="260" Padding="0"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                                   BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                <Grid RowDefinitions="*,Auto">
                                    <BoxView Grid.Row="0"
                                             Color="{StaticResource TertiaryLight}"
                                             CornerRadius="16,16,0,0" />
                                    <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="6">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="🍣" FontSize="14" />
                                            <Label Text=""
                                                   Style="{StaticResource CardTitle}" />
                                        </HorizontalStackLayout>
                                        <Label Text=""
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                          Dark={StaticResource TextDimDark}}" />
                                        <BoxView HeightRequest="1"
                                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                                 Margin="0,4" />
                                        <Label Text=""
                                               FontSize="13" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Tertiary},
                                                                          Dark={StaticResource TertiaryDark}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- === Near You === -->
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" Padding="28,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <BoxView WidthRequest="28" HeightRequest="4"
                                     CornerRadius="2"
                                     Color="{StaticResource Secondary}" />
                            <Label Text="Near You"
                                   Style="{StaticResource SectionTitle}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="See All"
                               FontSize="14" FontAttributes="Bold"
                               VerticalOptions="End"
                               TextColor="{AppThemeBinding Light={StaticResource Secondary},
                                                           Dark={StaticResource SecondaryDark}}" />
                    </Grid>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="14" Padding="28,0">
                            <!-- Card 1 -->
                            <Frame WidthRequest="170" HeightRequest="220" Padding="16"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                                   BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                <VerticalStackLayout Spacing="10">
                                    <BoxView WidthRequest="48" HeightRequest="48"
                                             CornerRadius="14"
                                             Color="{StaticResource PrimaryLight}" />
                                    <Label Text=""
                                           FontSize="16" FontAttributes="Bold"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                       Dark={StaticResource TextDark}}" />
                                    <Label Text=""
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                       Dark={StaticResource TextDimDark}}" />
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="★" FontSize="13"
                                               TextColor="{StaticResource Tertiary}" />
                                        <Label Text="" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                          Dark={StaticResource TextDimDark}}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                            <!-- Card 2 -->
                            <Frame WidthRequest="170" HeightRequest="220" Padding="16"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                                   BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                <VerticalStackLayout Spacing="10">
                                    <BoxView WidthRequest="48" HeightRequest="48"
                                             CornerRadius="14"
                                             Color="{StaticResource SecondaryLight}" />
                                    <Label Text=""
                                           FontSize="16" FontAttributes="Bold"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                       Dark={StaticResource TextDark}}" />
                                    <Label Text=""
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                       Dark={StaticResource TextDimDark}}" />
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="★" FontSize="13"
                                               TextColor="{StaticResource Tertiary}" />
                                        <Label Text="" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                          Dark={StaticResource TextDimDark}}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                            <!-- Card 3 -->
                            <Frame WidthRequest="170" HeightRequest="220" Padding="16"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                                   BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                <VerticalStackLayout Spacing="10">
                                    <BoxView WidthRequest="48" HeightRequest="48"
                                             CornerRadius="14"
                                             Color="{StaticResource TertiaryLight}" />
                                    <Label Text=""
                                           FontSize="16" FontAttributes="Bold"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                       Dark={StaticResource TextDark}}" />
                                    <Label Text=""
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                       Dark={StaticResource TextDimDark}}" />
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="★" FontSize="13"
                                               TextColor="{StaticResource Tertiary}" />
                                        <Label Text="" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                          Dark={StaticResource TextDimDark}}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- === Categories === -->
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Padding="28,0" Spacing="6">
                        <BoxView WidthRequest="28" HeightRequest="4"
                                 CornerRadius="2"
                                 Color="{StaticResource Tertiary}" />
                        <Label Text="Categories"
                               Style="{StaticResource SectionTitle}" />
                    </VerticalStackLayout>
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" Padding="28,0">
                        <Frame BackgroundColor="{StaticResource PrimaryLight}"
                               BorderColor="Transparent"
                               CornerRadius="20" Padding="16,10"
                               Margin="0,0,10,10" HasShadow="False">
                            <Label Text=""
                                   FontSize="14" FontAttributes="Bold"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource Primary}" />
                        </Frame>
                        <Frame BackgroundColor="{StaticResource SecondaryLight}"
                               BorderColor="Transparent"
                               CornerRadius="20" Padding="16,10"
                               Margin="0,0,10,10" HasShadow="False">
                            <Label Text=""
                                   FontSize="14" FontAttributes="Bold"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource Secondary}" />
                        </Frame>
                        <Frame BackgroundColor="{StaticResource TertiaryLight}"
                               BorderColor="Transparent"
                               CornerRadius="20" Padding="16,10"
                               Margin="0,0,10,10" HasShadow="False">
                            <Label Text=""
                                   FontSize="14" FontAttributes="Bold"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource Tertiary}" />
                        </Frame>
                        <Frame BackgroundColor="{StaticResource PrimaryLight}"
                               BorderColor="Transparent"
                               CornerRadius="20" Padding="16,10"
                               Margin="0,0,10,10" HasShadow="False">
                            <Label Text=""
                                   FontSize="14" FontAttributes="Bold"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource Primary}" />
                        </Frame>
                        <Frame BackgroundColor="{StaticResource SecondaryLight}"
                               BorderColor="Transparent"
                               CornerRadius="20" Padding="16,10"
                               Margin="0,0,10,10" HasShadow="False">
                            <Label Text=""
                                   FontSize="14" FontAttributes="Bold"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource Secondary}" />
                        </Frame>
                        <Frame BackgroundColor="{StaticResource TertiaryLight}"
                               BorderColor="Transparent"
                               CornerRadius="20" Padding="16,10"
                               Margin="0,0,10,10" HasShadow="False">
                            <Label Text=""
                                   FontSize="14" FontAttributes="Bold"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource Tertiary}" />
                        </Frame>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- === Recommended === -->
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Padding="28,0" Spacing="6">
                        <BoxView WidthRequest="28" HeightRequest="4"
                                 CornerRadius="2"
                                 Color="{StaticResource Accent}" />
                        <Label Text="Recommended For You"
                               Style="{StaticResource SectionTitle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="12" Padding="28,0">
                        <!-- Item 1 -->
                        <Frame Padding="0" HasShadow="False"
                               BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                               BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                            <Grid ColumnDefinitions="80,*,Auto"
                                  ColumnSpacing="14" Padding="12">
                                <BoxView Grid.Column="0"
                                         CornerRadius="12"
                                         Color="{StaticResource PrimaryLight}" />
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center" Spacing="4">
                                    <Label Text=""
                                           FontSize="16" FontAttributes="Bold"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                       Dark={StaticResource TextDark}}" />
                                    <Label Text=""
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                       Dark={StaticResource TextDimDark}}" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource Tertiary}" />
                                        <Label Text="" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                          Dark={StaticResource TextDimDark}}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Frame Grid.Column="2"
                                       WidthRequest="44" HeightRequest="44"
                                       CornerRadius="14" Padding="0"
                                       HasShadow="False"
                                       BackgroundColor="{StaticResource PrimaryLight}"
                                       BorderColor="Transparent"
                                       VerticalOptions="Center">
                                    <Label Text="♥" FontSize="18"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Primary}" />
                                </Frame>
                            </Grid>
                        </Frame>
                        <!-- Item 2 -->
                        <Frame Padding="0" HasShadow="False"
                               BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                               BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                            <Grid ColumnDefinitions="80,*,Auto"
                                  ColumnSpacing="14" Padding="12">
                                <BoxView Grid.Column="0"
                                         CornerRadius="12"
                                         Color="{StaticResource SecondaryLight}" />
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center" Spacing="4">
                                    <Label Text=""
                                           FontSize="16" FontAttributes="Bold"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                       Dark={StaticResource TextDark}}" />
                                    <Label Text=""
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                       Dark={StaticResource TextDimDark}}" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource Tertiary}" />
                                        <Label Text="" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                          Dark={StaticResource TextDimDark}}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Frame Grid.Column="2"
                                       WidthRequest="44" HeightRequest="44"
                                       CornerRadius="14" Padding="0"
                                       HasShadow="False"
                                       BackgroundColor="{StaticResource SecondaryLight}"
                                       BorderColor="Transparent"
                                       VerticalOptions="Center">
                                    <Label Text="♥" FontSize="18"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Secondary}" />
                                </Frame>
                            </Grid>
                        </Frame>
                        <!-- Item 3 -->
                        <Frame Padding="0" HasShadow="False"
                               BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                               BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                            <Grid ColumnDefinitions="80,*,Auto"
                                  ColumnSpacing="14" Padding="12">
                                <BoxView Grid.Column="0"
                                         CornerRadius="12"
                                         Color="{StaticResource TertiaryLight}" />
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center" Spacing="4">
                                    <Label Text=""
                                           FontSize="16" FontAttributes="Bold"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                       Dark={StaticResource TextDark}}" />
                                    <Label Text=""
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                       Dark={StaticResource TextDimDark}}" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource Tertiary}" />
                                        <Label Text="" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                          Dark={StaticResource TextDimDark}}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Frame Grid.Column="2"
                                       WidthRequest="44" HeightRequest="44"
                                       CornerRadius="14" Padding="0"
                                       HasShadow="False"
                                       BackgroundColor="{StaticResource PrimaryLight}"
                                       BorderColor="Transparent"
                                       VerticalOptions="Center">
                                    <Label Text="♥" FontSize="18"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Primary}" />
                                </Frame>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
