<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodAndDrink.MainPage"
             Shell.NavBarIsVisible="False"
             Title="Food &amp; Drink">

    <ScrollView>
        <VerticalStackLayout Spacing="0"
                             BackgroundColor="{AppThemeBinding Light={StaticResource OffWhite},
                                                              Dark={StaticResource Black}}">

            <!-- ===== Header ===== -->
            <VerticalStackLayout Padding="28,56,28,16" Spacing="16"
                                 BackgroundColor="{StaticResource BgWarmLight}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Discover"
                               FontSize="{DynamicResource HeroFontSize}" FontAttributes="Bold"
                               FontFamily="OpenSansSemibold"
                               SemanticProperties.Description="Discover"
                               TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                           Dark={StaticResource TextDark}}" />
                        <Label Text="Find the best food &amp; drinks near you"
                               FontSize="{DynamicResource MediumFontSize}"
                               SemanticProperties.Description="Find the best food and drinks near you"
                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                           Dark={StaticResource TextDimDark}}" />
                    </VerticalStackLayout>
                    <Frame Grid.Column="1"
                           WidthRequest="44" HeightRequest="44"
                           CornerRadius="14" Padding="0" HasShadow="False"
                           BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray100}}"
                           BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                           VerticalOptions="Center">
                        <Label Text="🔔" FontSize="18"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                </Grid>
                <SearchBar x:Name="MainSearchBar"
                           Placeholder="Search dishes, drinks, places..."
                           SemanticProperties.Description="Search food and drinks"
                           SemanticProperties.Hint="Enter a dish name, ingredient, or cuisine type"
                           SearchButtonPressed="OnMainSearchPressed" />
            </VerticalStackLayout>

            <!-- ===== Content ===== -->
            <VerticalStackLayout Spacing="28" Padding="0,24,0,48">

                <!-- === Trending Now === -->
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" Padding="28,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <BoxView WidthRequest="28" HeightRequest="4"
                                     CornerRadius="2"
                                     Color="{StaticResource Primary}" />
                            <Label Text="Trending Now"
                                   Style="{StaticResource SectionTitle}"
                                   SemanticProperties.Description="Trending Now section" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="See All"
                               FontSize="14" FontAttributes="Bold"
                               VerticalOptions="End"
                               SemanticProperties.Description="See all trending items"
                               SemanticProperties.Hint="Tap to view all trending items"
                               TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                           Dark={StaticResource PrimaryDark}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTrendingSeeAllClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout x:Name="TrendingStack" Spacing="14" Padding="28,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Frame WidthRequest="200" HeightRequest="260" Padding="0"
                                           HasShadow="False" CornerRadius="16"
                                           BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                                           BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnItemTapped"
                                                                  CommandParameter="{Binding Id}" />
                                        </Frame.GestureRecognizers>
                                        <Grid RowDefinitions="*,Auto">
                                            <Frame Grid.Row="0"
                                                   BackgroundColor="{StaticResource PrimaryLight}"
                                                   CornerRadius="16,16,0,0"
                                                   Padding="0" HasShadow="False"
                                                   BorderColor="Transparent">
                                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                            </Frame>
                                            <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="6">
                                                <Label Text="{Binding Name}"
                                                       Style="{StaticResource CardTitle}"
                                                       SemanticProperties.Description="{Binding Name}" />
                                                <Label Text="{Binding Subtitle}"
                                                       FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                                  Dark={StaticResource TextDimDark}}" />
                                                <BoxView HeightRequest="1"
                                                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                                         Margin="0,4" />
                                                <Label FontSize="13" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                                                  Dark={StaticResource PrimaryDark}}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="★ " />
                                                            <Span Text="{Binding Rating, StringFormat='{0:F1}'}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- === Near You === -->
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" Padding="28,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <BoxView WidthRequest="28" HeightRequest="4"
                                     CornerRadius="2"
                                     Color="{StaticResource Secondary}" />
                            <Label Text="Near You"
                                   Style="{StaticResource SectionTitle}"
                                   SemanticProperties.Description="Near You section" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="See All"
                               FontSize="14" FontAttributes="Bold"
                               VerticalOptions="End"
                               SemanticProperties.Description="See all nearby items"
                               SemanticProperties.Hint="Tap to view all nearby items"
                               TextColor="{AppThemeBinding Light={StaticResource Secondary},
                                                           Dark={StaticResource SecondaryDark}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNearYouSeeAllClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout x:Name="NearYouStack" Spacing="14" Padding="28,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Frame WidthRequest="170" HeightRequest="220" Padding="16"
                                           HasShadow="False" CornerRadius="16"
                                           BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                                           BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnItemTapped"
                                                                  CommandParameter="{Binding Id}" />
                                        </Frame.GestureRecognizers>
                                        <VerticalStackLayout Spacing="10">
                                            <Frame WidthRequest="48" HeightRequest="48"
                                                   CornerRadius="14" Padding="0"
                                                   HasShadow="False"
                                                   BackgroundColor="{StaticResource SecondaryLight}"
                                                   BorderColor="Transparent">
                                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                            </Frame>
                                            <Label Text="{Binding Name}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   FontFamily="OpenSansSemibold"
                                                   SemanticProperties.Description="{Binding Name}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                               Dark={StaticResource TextDark}}" />
                                            <Label Text="{Binding Subtitle}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                               Dark={StaticResource TextDimDark}}" />
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="★" FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource TertiaryDark}}" />
                                                <Label Text="{Binding Rating, StringFormat='{0:F1}'}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                                  Dark={StaticResource TextDimDark}}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- === Categories === -->
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Padding="28,0" Spacing="6">
                        <BoxView WidthRequest="28" HeightRequest="4"
                                 CornerRadius="2"
                                 Color="{StaticResource Tertiary}" />
                        <Label Text="Categories"
                               Style="{StaticResource SectionTitle}"
                               SemanticProperties.Description="Categories section" />
                    </VerticalStackLayout>
                    <FlexLayout x:Name="CategoryPillsLayout" Wrap="Wrap" JustifyContent="Start"
                                AlignItems="Center" Padding="28,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="14,10" CornerRadius="22"
                                       Margin="0,0,10,10" HasShadow="False"
                                       BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCategoryTapped"
                                                              CommandParameter="{Binding Id}" />
                                    </Frame.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding IconEmoji}"
                                               FontSize="16"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Name}"
                                               FontAttributes="Bold"
                                               FontFamily="OpenSansSemibold"
                                               LineBreakMode="NoWrap"
                                               VerticalOptions="Center"
                                               SemanticProperties.Description="{Binding Name}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                           Dark={StaticResource TextDark}}" />
                                    </HorizontalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- === Recommended === -->
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Padding="28,0" Spacing="6">
                        <BoxView WidthRequest="28" HeightRequest="4"
                                 CornerRadius="2"
                                 Color="{StaticResource Accent}" />
                        <Label Text="Recommended For You"
                               Style="{StaticResource SectionTitle}"
                               SemanticProperties.Description="Recommended for you section" />
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="RecommendedStack" Spacing="12" Padding="28,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="0" HasShadow="False" CornerRadius="16"
                                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                                       BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemTapped"
                                                              CommandParameter="{Binding Id}" />
                                    </Frame.GestureRecognizers>
                                    <Grid ColumnDefinitions="80,*,Auto"
                                          ColumnSpacing="14" Padding="12">
                                        <Frame Grid.Column="0"
                                               CornerRadius="12" Padding="0"
                                               HasShadow="False"
                                               BackgroundColor="{StaticResource TertiaryLight}"
                                               BorderColor="Transparent">
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        </Frame>
                                        <VerticalStackLayout Grid.Column="1"
                                                             VerticalOptions="Center" Spacing="4">
                                            <Label Text="{Binding Name}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   FontFamily="OpenSansSemibold"
                                                   SemanticProperties.Description="{Binding Name}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                               Dark={StaticResource TextDark}}" />
                                            <Label Text="{Binding Subtitle}"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                               Dark={StaticResource TextDimDark}}" />
                                            <HorizontalStackLayout Spacing="6">
                                                <Label FontSize="12" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource TertiaryDark}}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="★ " />
                                                            <Span Text="{Binding Rating, StringFormat='{0:F1}'}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label Text="{Binding ReviewCount, StringFormat='({0})'}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                                  Dark={StaticResource TextDimDark}}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Frame Grid.Column="2"
                                               WidthRequest="44" HeightRequest="44"
                                               CornerRadius="14" Padding="0"
                                               HasShadow="False"
                                               BackgroundColor="{StaticResource PrimaryLight}"
                                               BorderColor="Transparent"
                                               VerticalOptions="Center"
                                               SemanticProperties.Description="Toggle favorite"
                                               SemanticProperties.Hint="Tap to save or remove this item from your favorites">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnFavoriteTapped"
                                                                      CommandParameter="{Binding Id}" />
                                            </Frame.GestureRecognizers>
                                            <Label Text="♡" FontSize="18"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        </Frame>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
