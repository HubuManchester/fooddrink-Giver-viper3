<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodAndDrink.FavoritesPage"
             Shell.NavBarIsVisible="False"
             Title="Favorites">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource OffWhite},
                                            Dark={StaticResource Black}}">

        <!-- ===== Header ===== -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="28,56,28,8"
                             Spacing="8">
            <BoxView WidthRequest="28" HeightRequest="4"
                     CornerRadius="2"
                     Color="{StaticResource Accent}" />
            <Label Text="Favorites"
                   FontSize="32"
                   FontAttributes="Bold"
                   FontFamily="OpenSansSemibold"
                   AutomationProperties.Name="Favorites"
                   TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                               Dark={StaticResource TextDark}}" />
            <Label Text="Your saved dishes and places"
                   FontSize="14"
                   AutomationProperties.Name="Your saved dishes and places"
                   TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                               Dark={StaticResource TextDimDark}}" />
        </VerticalStackLayout>

        <!-- ===== Content ===== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="24" Padding="28,16,28,48">
                <VerticalStackLayout Spacing="6">
                    <BoxView WidthRequest="24" HeightRequest="3"
                             CornerRadius="2"
                             Color="{StaticResource Primary}" />
                    <Label Text="Saved Items" FontSize="16" FontAttributes="Bold"
                           FontFamily="OpenSansSemibold"
                           AutomationProperties.Name="Saved items list"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                       Dark={StaticResource TextDark}}" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="FavoritesListStack" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="0" HasShadow="False" CornerRadius="16"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                                   BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnItemTapped"
                                                          CommandParameter="{Binding Id}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="72,*,Auto"
                                      ColumnSpacing="14" Padding="12">
                                    <Frame Grid.Column="0"
                                           CornerRadius="12" Padding="0"
                                           HasShadow="False"
                                           BackgroundColor="{StaticResource PrimaryLight}"
                                           BorderColor="Transparent">
                                        <Label Text="{Binding IconEmoji}" FontSize="30"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Frame>
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center" Spacing="4">
                                        <Label Text="{Binding Name}"
                                               FontSize="16" FontAttributes="Bold"
                                               FontFamily="OpenSansSemibold"
                                               AutomationProperties.Name="{Binding Name}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                           Dark={StaticResource TextDark}}" />
                                        <Label Text="{Binding Subtitle}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                           Dark={StaticResource TextDimDark}}" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label FontSize="12" FontAttributes="Bold"
                                                   TextColor="{StaticResource Tertiary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="★ " />
                                                        <Span Text="{Binding Rating, StringFormat='{0:F1}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Text="{Binding ReviewCount, StringFormat='({0})'}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                              Dark={StaticResource TextDimDark}}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Frame Grid.Column="2"
                                           WidthRequest="44" HeightRequest="44"
                                           CornerRadius="14" Padding="0"
                                           HasShadow="False"
                                           BackgroundColor="{StaticResource Primary}"
                                           BorderColor="Transparent"
                                           VerticalOptions="Center"
                                           AutomationProperties.Name="Remove from favorites"
                                           AutomationProperties.HelpText="Tap to remove this item from your favorites">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnUnfavoriteTapped"
                                                                  CommandParameter="{Binding Id}" />
                                        </Frame.GestureRecognizers>
                                        <Label Text="♥" FontSize="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource White}" />
                                    </Frame>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== Empty State ===== -->
        <VerticalStackLayout Grid.Row="1"
                             x:Name="EmptyState"
                             IsVisible="False"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="18"
                             Padding="40">
            <BoxView WidthRequest="64" HeightRequest="64"
                     CornerRadius="20"
                     Color="{StaticResource SecondaryLight}"
                     HorizontalOptions="Center" />
            <Label Text="No favorites yet"
                   FontSize="18" FontAttributes="Bold"
                   HorizontalOptions="Center"
                   FontFamily="OpenSansSemibold"
                   AutomationProperties.Name="No favorites yet"
                   TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                               Dark={StaticResource TextDark}}" />
            <Label Text="Tap the heart icon on any item to save it here"
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   AutomationProperties.Name="Tap the heart icon on any item to save it here"
                   TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                               Dark={StaticResource TextDimDark}}" />
            <Button Text="Explore Dishes"
                    BackgroundColor="{StaticResource Primary}"
                    CornerRadius="14"
                    HorizontalOptions="Center"
                    AutomationProperties.Name="Explore dishes"
                    Margin="0,8,0,0" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
