<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
             x:Class="FoodAndDrink.ScanPage"
             Shell.NavBarIsVisible="True"
             Title="Scan Barcode">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource Black},
                                            Dark={StaticResource Black}}">

        <!-- Barcode Scanner View -->
        <zxing:CameraBarcodeReaderView Grid.Row="0"
            x:Name="BarcodeReader"
            BarcodesDetected="OnBarcodesDetected"
            IsDetecting="True" />

        <!-- Overlay hint -->
        <VerticalStackLayout Grid.Row="0"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="16">
            <BoxView WidthRequest="250" HeightRequest="250"
                     CornerRadius="16"
                     Color="Transparent"
                     Opacity="0" />
            <Label Text="Point camera at a barcode or QR code"
                   FontSize="{DynamicResource MediumFontSize}"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Opacity="0.8" />
        </VerticalStackLayout>

        <!-- Bottom bar -->
        <Frame Grid.Row="1"
               BackgroundColor="{StaticResource Black}"
               BorderColor="Transparent"
               CornerRadius="0" Padding="28,16" HasShadow="False">
            <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        x:Name="FlashlightBtn"
                        Text="🔦"
                        WidthRequest="48" HeightRequest="48"
                        CornerRadius="14"
                        BackgroundColor="{StaticResource Gray100}"
                        TextColor="White"
                        Clicked="OnFlashlightClicked" />
                <Button Grid.Column="2"
                        Text="Cancel"
                        BackgroundColor="{StaticResource Gray100}"
                        TextColor="White"
                        CornerRadius="14" HeightRequest="48"
                        HorizontalOptions="End"
                        WidthRequest="120"
                        Clicked="OnCancelClicked" />
            </Grid>
        </Frame>
    </Grid>

</ContentPage>
