<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
             x:Class="FoodAndDrink.ScanPage"
             Shell.NavBarIsVisible="True"
             Title="Scan Barcode">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="Black">

        <!-- ZXing Barcode Scanner -->
        <zxing:CameraBarcodeReaderView Grid.Row="0"
            x:Name="BarcodeReader"
            CameraLocation="Rear"
            BarcodesDetected="OnBarcodesDetected"
            IsDetecting="False"
            AutomationProperties.Name="Barcode scanner camera view"
            AutomationProperties.HelpText="Point the camera at a barcode or QR code to scan" />

        <!-- Scanning frame overlay -->
        <Frame Grid.Row="0"
               WidthRequest="250" HeightRequest="250"
               CornerRadius="16"
               HasShadow="False"
               BackgroundColor="Transparent"
               BorderColor="White"
               Opacity="0.4"
               VerticalOptions="Center"
               HorizontalOptions="Center" />

        <!-- Hint text -->
        <Label Grid.Row="0"
               Text="Point camera at a barcode or QR code"
               FontSize="{DynamicResource MediumFontSize}"
               TextColor="White"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,0,0,180"
               Opacity="0.7"
               AutomationProperties.Name="Scanning hint"
               AutomationProperties.HelpText="Point the camera at a barcode or QR code to scan automatically" />

        <!-- Bottom bar -->
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12"
              Padding="28,16"
              BackgroundColor="#1A1A1A">

            <!-- Flashlight toggle -->
            <Button Grid.Column="0"
                    x:Name="FlashlightBtn"
                    Text="🔦 Flashlight"
                    HeightRequest="44"
                    CornerRadius="12"
                    Padding="14,8"
                    FontSize="13"
                    BackgroundColor="#3A3A3A"
                    TextColor="White"
                    BorderColor="Transparent"
                    AutomationProperties.Name="Flashlight toggle"
                    AutomationProperties.HelpText="Turn the camera flash on or off for better scanning in low light"
                    Clicked="OnFlashlightClicked" />

            <!-- Cancel -->
            <Button Grid.Column="2"
                    Text="Cancel"
                    HeightRequest="44" WidthRequest="100"
                    CornerRadius="12"
                    FontSize="13"
                    BackgroundColor="#3A3A3A"
                    TextColor="White"
                    BorderColor="Transparent"
                    AutomationProperties.Name="Cancel scanning"
                    AutomationProperties.HelpText="Return to the previous page"
                    Clicked="OnCancelClicked" />
        </Grid>
    </Grid>

</ContentPage>
