<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodAndDrink.ExplorePage"
             Shell.NavBarIsVisible="False"
             Title="Explore">

    <ScrollView>
        <VerticalStackLayout Spacing="0"
                             BackgroundColor="{AppThemeBinding Light={StaticResource OffWhite},
                                                              Dark={StaticResource Black}}">

            <!-- ===== Header ===== -->
            <VerticalStackLayout Padding="28,56,28,16" Spacing="16"
                                 BackgroundColor="{StaticResource BgGreenLight}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Explore"
                           FontSize="{DynamicResource HeroFontSize}" FontAttributes="Bold"
                           FontFamily="OpenSansSemibold"
                           AutomationProperties.Name="Explore"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                       Dark={StaticResource TextDark}}" />
                    <Label Text="Find your next favorite"
                           FontSize="{DynamicResource MediumFontSize}"
                           AutomationProperties.Name="Find your next favorite"
                           TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                       Dark={StaticResource TextDimDark}}" />
                </VerticalStackLayout>
                <SearchBar x:Name="ExploreSearchBar"
                           Placeholder="Search by name, ingredient, or cuisine..."
                           AutomationProperties.Name="Search food and drinks"
                           AutomationProperties.HelpText="Search by name, ingredient, or cuisine"
                           SearchButtonPressed="OnExploreSearchPressed" />
            </VerticalStackLayout>

            <!-- ===== Smart Scan Card ===== -->
            <Frame Margin="28,20,28,8"
                   BackgroundColor="{StaticResource SecondaryLight}"
                   BorderColor="Transparent"
                   CornerRadius="16" Padding="20" HasShadow="False"
                   AutomationProperties.Name="Smart Scan"
                   AutomationProperties.HelpText="Scan a dish or barcode to instantly find reviews and nutrition info">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0"
                                         VerticalOptions="Center"
                                         Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <BoxView WidthRequest="4" HeightRequest="20"
                                     CornerRadius="2"
                                     Color="{StaticResource Secondary}" />
                            <Label Text="Smart Scan"
                                   Style="{StaticResource CardTitle}" />
                        </HorizontalStackLayout>
                        <Label Text="Scan a dish or barcode to instantly find reviews, nutrition info, and nearby options."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                           Dark={StaticResource TextDimDark}}"
                               LineHeight="1.5" />
                        <FlexLayout Wrap="NoWrap" Direction="Row">
                            <Button x:Name="ScanCameraBtn"
                                    Text="Open Camera"
                                    CornerRadius="12"
                                    HeightRequest="44"
                                    Padding="18,10"
                                    FontSize="13"
                                    AutomationProperties.Name="Open Camera"
                                    AutomationProperties.HelpText="Tap to take a photo of a dish"
                                    BackgroundColor="{StaticResource Secondary}"
                                    TextColor="White"
                                    Clicked="OnCameraScanClicked" />
                            <Button x:Name="ScanBarcodeBtn"
                                    Text="Scan Barcode"
                                    CornerRadius="12"
                                    HeightRequest="44"
                                    Padding="18,10"
                                    FontSize="13"
                                    Margin="10,0,0,0"
                                    AutomationProperties.Name="Scan Barcode"
                                    AutomationProperties.HelpText="Tap to scan a barcode"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                Dark={StaticResource TextDark}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource BorderLight},
                                                                   Dark={StaticResource BorderDark}}"
                                    BorderWidth="1"
                                    Clicked="OnBarcodeScanClicked" />
                        </FlexLayout>
                    </VerticalStackLayout>
                    <BoxView Grid.Column="1"
                             WidthRequest="56" HeightRequest="56"
                             CornerRadius="16"
                             Color="{StaticResource Secondary}"
                             Opacity="0.15"
                             VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- ===== Content ===== -->
            <VerticalStackLayout Spacing="28" Padding="28,16,28,48">

                <!-- === Browse by Category === -->
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <BoxView WidthRequest="28" HeightRequest="4"
                                 CornerRadius="2"
                                 Color="{StaticResource Primary}" />
                        <Label Text="Browse by Category"
                               Style="{StaticResource SectionTitle}"
                               AutomationProperties.Name="Browse by Category" />
                    </VerticalStackLayout>
                    <Grid x:Name="CategoryGrid"
                          ColumnDefinitions="{OnIdiom Phone='*,*', Tablet='*,*,*,*'}"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="12" RowSpacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                                       BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                       CornerRadius="16" Padding="18" HasShadow="False"
                                       HeightRequest="120">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCategoryTapped"
                                                              CommandParameter="{Binding Id}" />
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout VerticalOptions="End" Spacing="6">
                                        <Frame WidthRequest="44" HeightRequest="44"
                                               CornerRadius="12" Padding="0"
                                               HasShadow="False"
                                               BackgroundColor="{StaticResource PrimaryLight}"
                                               BorderColor="Transparent">
                                            <Label Text="{Binding IconEmoji}" FontSize="22"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Frame>
                                        <Label Text="{Binding Name}"
                                               FontSize="15" FontAttributes="Bold"
                                               FontFamily="OpenSansSemibold"
                                               AutomationProperties.Name="{Binding Name}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                           Dark={StaticResource TextDark}}" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </Grid>
                </VerticalStackLayout>

                <!-- === Popular This Week === -->
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <BoxView WidthRequest="28" HeightRequest="4"
                                     CornerRadius="2"
                                     Color="{StaticResource Secondary}" />
                            <Label Text="Popular This Week"
                                   Style="{StaticResource SectionTitle}"
                                   AutomationProperties.Name="Popular This Week" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="See All"
                               FontSize="14" FontAttributes="Bold"
                               VerticalOptions="End"
                               AutomationProperties.Name="See all popular items"
                               TextColor="{AppThemeBinding Light={StaticResource Secondary},
                                                           Dark={StaticResource SecondaryDark}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPopularSeeAllClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout x:Name="PopularStack" Spacing="14">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Frame WidthRequest="180" HeightRequest="240" Padding="16"
                                           HasShadow="False" CornerRadius="16"
                                           BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                                           BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnItemTapped"
                                                                  CommandParameter="{Binding Id}" />
                                        </Frame.GestureRecognizers>
                                        <VerticalStackLayout Spacing="10">
                                            <Frame WidthRequest="52" HeightRequest="52"
                                                   CornerRadius="14" Padding="0"
                                                   HasShadow="False"
                                                   BackgroundColor="{StaticResource PrimaryLight}"
                                                   BorderColor="Transparent">
                                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                            </Frame>
                                            <Label Text="{Binding Name}"
                                                   FontSize="15" FontAttributes="Bold"
                                                   FontFamily="OpenSansSemibold"
                                                   AutomationProperties.Name="{Binding Name}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                               Dark={StaticResource TextDark}}" />
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="★" FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource TertiaryDark}}" />
                                                <Label Text="{Binding Rating, StringFormat='{0:F1}'}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                                  Dark={StaticResource TextDimDark}}" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding PriceTier}"
                                                   FontSize="15" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                                              Dark={StaticResource PrimaryDark}}" />
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- === Recently Viewed === -->
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <BoxView WidthRequest="28" HeightRequest="4"
                                     CornerRadius="2"
                                     Color="{AppThemeBinding Light={StaticResource Gray400},
                                                             Dark={StaticResource Gray300}}" />
                            <Label Text="Recently Viewed"
                                   Style="{StaticResource SectionTitle}"
                                   AutomationProperties.Name="Recently Viewed" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="Clear All"
                               FontSize="14"
                               VerticalOptions="End"
                               AutomationProperties.Name="Clear recently viewed"
                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                           Dark={StaticResource TextDimDark}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClearRecentClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <VerticalStackLayout x:Name="RecentStack" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="14" HasShadow="False" CornerRadius="16"
                                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                                       BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemTapped"
                                                              CommandParameter="{Binding Id}" />
                                    </Frame.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="14">
                                        <Frame WidthRequest="56" HeightRequest="56"
                                               CornerRadius="12" Padding="0"
                                               HasShadow="False"
                                               BackgroundColor="{StaticResource SecondaryLight}"
                                               BorderColor="Transparent">
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        </Frame>
                                        <VerticalStackLayout VerticalOptions="Center" Spacing="3">
                                            <Label Text="{Binding Name}"
                                                   FontSize="15" FontAttributes="Bold"
                                                   FontFamily="OpenSansSemibold"
                                                   AutomationProperties.Name="{Binding Name}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                               Dark={StaticResource TextDark}}" />
                                            <Label Text="{Binding Subtitle}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                               Dark={StaticResource TextDimDark}}" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- ===== Empty State ===== -->
            <VerticalStackLayout x:Name="EmptyState"
                                 IsVisible="False"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="18"
                                 Padding="40,60">
                <BoxView WidthRequest="64" HeightRequest="64"
                         CornerRadius="20"
                         Color="{StaticResource SecondaryLight}"
                         HorizontalOptions="Center" />
                <Label Text="Nothing here yet"
                       FontSize="{DynamicResource LargeFontSize}" FontAttributes="Bold"
                       HorizontalOptions="Center"
                       FontFamily="OpenSansSemibold"
                       AutomationProperties.Name="Nothing here yet"
                       TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                   Dark={StaticResource TextDark}}" />
                <Label Text="Try searching or adjusting your filters"
                       FontSize="{DynamicResource MediumFontSize}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       AutomationProperties.Name="Try searching or adjusting your filters"
                       TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                   Dark={StaticResource TextDimDark}}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
