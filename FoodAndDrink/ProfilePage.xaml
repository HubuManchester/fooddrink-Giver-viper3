<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodAndDrink.ProfilePage"
             Shell.NavBarIsVisible="False"
             Title="Profile">

    <ScrollView>
        <VerticalStackLayout Spacing="0"
                             BackgroundColor="{AppThemeBinding Light={StaticResource OffWhite},
                                                              Dark={StaticResource Black}}">

            <!-- ===== Header ===== -->
            <Grid RowDefinitions="Auto">
                <!-- Background decoration -->
                <BoxView HeightRequest="200"
                         Color="{AppThemeBinding Light={StaticResource BgWarmLight},
                                                 Dark={StaticResource BgWarmDark}}" />

                <VerticalStackLayout Spacing="20" Padding="28,56,28,32"
                                     HorizontalOptions="Center">
                    <!-- Avatar -->
                    <Border StrokeShape="RoundRectangle 28"
                            Stroke="{AppThemeBinding Light={StaticResource Primary},
                                                     Dark={StaticResource PrimaryDark}}"
                            StrokeThickness="3"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            HeightRequest="96" WidthRequest="96"
                            HorizontalOptions="Center"
                            AutomationProperties.Name="User profile avatar"
                            AutomationProperties.HelpText="Your profile picture">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource PrimaryBrush}"
                                    Offset="0,4" Radius="16" Opacity="0.25" />
                        </Border.Shadow>
                        <Label Text="🍽️" FontSize="44"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label x:Name="UserName"
                               Text="Food Lover"
                               FontSize="{DynamicResource TitleFontSize}" FontAttributes="Bold"
                               FontFamily="OpenSansSemibold"
                               HorizontalOptions="Center"
                               AutomationProperties.Name="User name"
                               AutomationProperties.HelpText="Your display name"
                               TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                           Dark={StaticResource TextDark}}" />
                        <Label Text="Discover great food every day ✨"
                               FontSize="{DynamicResource MediumFontSize}"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                           Dark={StaticResource TextDimDark}}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <!-- ===== Stats Row ===== -->
            <Frame Margin="28,0,28,24"
                   Padding="0" HasShadow="False" CornerRadius="20"
                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                   BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                <Grid ColumnDefinitions="*,*,*" Padding="8">
                    <!-- Favorites -->
                    <VerticalStackLayout Grid.Column="0"
                                         HorizontalOptions="Center" Spacing="6"
                                         Padding="16,18"
                                         AutomationProperties.Name="Favorites count"
                                         AutomationProperties.HelpText="Number of items saved to your favorites">
                        <Frame WidthRequest="44" HeightRequest="44"
                               CornerRadius="14" Padding="0" HasShadow="False"
                               BackgroundColor="{StaticResource PrimaryLight}"
                               BorderColor="Transparent"
                               HorizontalOptions="Center">
                            <Label Text="❤️" FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>
                        <Label x:Name="StatFavorites"
                               Text="0"
                               FontSize="24" FontAttributes="Bold"
                               FontFamily="OpenSansSemibold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="Favorites" FontSize="12"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                           Dark={StaticResource TextDimDark}}" />
                    </VerticalStackLayout>

                    <!-- Scanned -->
                    <VerticalStackLayout Grid.Column="1"
                                         HorizontalOptions="Center" Spacing="6"
                                         Padding="16,18"
                                         AutomationProperties.Name="Scanned count"
                                         AutomationProperties.HelpText="Number of items you have scanned">
                        <Frame WidthRequest="44" HeightRequest="44"
                               CornerRadius="14" Padding="0" HasShadow="False"
                               BackgroundColor="{StaticResource SecondaryLight}"
                               BorderColor="Transparent"
                               HorizontalOptions="Center">
                            <Label Text="📸" FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>
                        <Label x:Name="StatScans"
                               Text="0"
                               FontSize="24" FontAttributes="Bold"
                               FontFamily="OpenSansSemibold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}" />
                        <Label Text="Scanned" FontSize="12"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                           Dark={StaticResource TextDimDark}}" />
                    </VerticalStackLayout>

                    <!-- Reviews -->
                    <VerticalStackLayout Grid.Column="2"
                                         HorizontalOptions="Center" Spacing="6"
                                         Padding="16,18"
                                         AutomationProperties.Name="Reviewed count"
                                         AutomationProperties.HelpText="Number of items you have reviewed">
                        <Frame WidthRequest="44" HeightRequest="44"
                               CornerRadius="14" Padding="0" HasShadow="False"
                               BackgroundColor="{StaticResource TertiaryLight}"
                               BorderColor="Transparent"
                               HorizontalOptions="Center">
                            <Label Text="⭐" FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>
                        <Label x:Name="StatReviews"
                               Text="0"
                               FontSize="24" FontAttributes="Bold"
                               FontFamily="OpenSansSemibold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource TertiaryDark}}" />
                        <Label Text="Reviewed" FontSize="12"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                           Dark={StaticResource TextDimDark}}" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- ===== Settings ===== -->
            <VerticalStackLayout Spacing="14" Padding="28,0,28,48">

                <!-- Appearance -->
                <Frame Padding="20" CornerRadius="16" HasShadow="False"
                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                       BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                    <VerticalStackLayout Spacing="0">
                        <HorizontalStackLayout Spacing="10" Margin="0,0,0,16">
                            <Frame WidthRequest="36" HeightRequest="36"
                                   CornerRadius="10" Padding="0" HasShadow="False"
                                   BackgroundColor="{StaticResource TertiaryLight}"
                                   BorderColor="Transparent">
                                <Label Text="🎨" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Appearance"
                                       FontSize="16" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                   Dark={StaticResource TextDark}}" />
                                <Label Text="Toggle between light and dark mode"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                   Dark={StaticResource TextDimDark}}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Dark Mode" FontSize="15"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                               Dark={StaticResource TextDark}}" />
                            <Switch Grid.Column="1" x:Name="DarkModeSwitch"
                                    Toggled="OnDarkModeToggled"
                                    VerticalOptions="Center"
                                    AutomationProperties.Name="Dark mode toggle"
                                    AutomationProperties.HelpText="Turn dark mode on or off" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Text Size -->
                <Frame Padding="20" CornerRadius="16" HasShadow="False"
                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                       BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                    <VerticalStackLayout Spacing="0">
                        <HorizontalStackLayout Spacing="10" Margin="0,0,0,16">
                            <Frame WidthRequest="36" HeightRequest="36"
                                   CornerRadius="10" Padding="0" HasShadow="False"
                                   BackgroundColor="{StaticResource SecondaryLight}"
                                   BorderColor="Transparent">
                                <Label Text="🔤" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Text Size"
                                       FontSize="16" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                   Dark={StaticResource TextDark}}" />
                                <Label x:Name="TextSizeLabel" Text="Medium"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                   Dark={StaticResource TextDimDark}}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="A" FontSize="12"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                               Dark={StaticResource TextDimDark}}" />
                            <Slider Grid.Column="1" x:Name="TextSizeSlider"
                                    Minimum="0" Maximum="1" Value="0.33"
                                    ValueChanged="OnTextSizeChanged"
                                    VerticalOptions="Center"
                                    AutomationProperties.Name="Text size slider"
                                    AutomationProperties.HelpText="Drag to adjust font size across the entire app" />
                            <Label Grid.Column="2" Text="A" FontSize="20" FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                               Dark={StaticResource TextDark}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- About -->
                <Frame Padding="20" CornerRadius="16" HasShadow="False"
                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                       BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                    <VerticalStackLayout Spacing="0">
                        <HorizontalStackLayout Spacing="10" Margin="0,0,0,16">
                            <Frame WidthRequest="36" HeightRequest="36"
                                   CornerRadius="10" Padding="0" HasShadow="False"
                                   BackgroundColor="{StaticResource PrimaryLight}"
                                   BorderColor="Transparent">
                                <Label Text="ℹ️" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="About"
                                       FontSize="16" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                                   Dark={StaticResource TextDark}}" />
                                <Label Text="Food &amp; Drink Discovery App"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                                   Dark={StaticResource TextDimDark}}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,14,0,0">
                            <Label Grid.Column="0" Text="Version" FontSize="15"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextLight},
                                                               Dark={StaticResource TextDark}}" />
                            <Label Grid.Column="1" Text="1.0.0" FontSize="14"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextDimLight},
                                                               Dark={StaticResource TextDimDark}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Logout -->
                <Button Text="Log Out"
                        HorizontalOptions="Fill"
                        CornerRadius="16"
                        HeightRequest="52"
                        Margin="0,8,0,0"
                        BackgroundColor="{StaticResource PrimaryLight}"
                        TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource Error}}"
                        FontSize="15"
                        FontFamily="OpenSansSemibold"
                        FontAttributes="Bold"
                        BorderColor="Transparent"
                        AutomationProperties.Name="Log out"
                        AutomationProperties.HelpText="Sign out of your account"
                        Clicked="OnLogoutClicked" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
