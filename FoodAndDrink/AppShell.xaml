<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FoodAndDrink.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FoodAndDrink"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource OffWhite}, Dark={StaticResource Black}}"
    Title="Food &amp; Drink">

    <TabBar>
        <ShellContent
            Title="🏠 Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="🔍 Explore"
            ContentTemplate="{DataTemplate local:ExplorePage}"
            Route="ExplorePage" />

        <ShellContent
            Title="❤️ Favorites"
            ContentTemplate="{DataTemplate local:FavoritesPage}"
            Route="FavoritesPage" />

        <ShellContent
            Title="👤 Profile"
            ContentTemplate="{DataTemplate local:ProfilePage}"
            Route="ProfilePage" />
    </TabBar>

</Shell>
