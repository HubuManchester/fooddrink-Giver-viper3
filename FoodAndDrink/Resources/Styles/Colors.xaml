<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Warm Kitchen Palette ===== -->

    <!-- Primary: Warm Orange-Red (appetizing, energetic) -->
    <Color x:Key="Primary">#FF6B35</Color>
    <Color x:Key="PrimaryDark">#FF8C5E</Color>
    <Color x:Key="PrimaryLight">#FFF2EC</Color>

    <!-- Secondary: Fresh Herb Green (freshness, balance) -->
    <Color x:Key="Secondary">#2D9C5E</Color>
    <Color x:Key="SecondaryDark">#45B875</Color>
    <Color x:Key="SecondaryLight">#EDF7F1</Color>

    <!-- Tertiary: Golden Amber (warmth, stars, highlights) -->
    <Color x:Key="Tertiary">#E8A317</Color>
    <Color x:Key="TertiaryDark">#F0B840</Color>
    <Color x:Key="TertiaryLight">#FFF8EA</Color>

    <!-- Accent: Deep Rose (special highlights) -->
    <Color x:Key="Accent">#D45161</Color>
    <Color x:Key="AccentLight">#FDEDEF</Color>

    <!-- Base -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#141210</Color>
    <Color x:Key="OffWhite">#FFFBF8</Color>

    <!-- Surface / Cards -->
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#282420</Color>
    <Color x:Key="BorderLight">#F0EBE4</Color>
    <Color x:Key="BorderDark">#3D3832</Color>

    <!-- Text -->
    <Color x:Key="TextLight">#1C1A18</Color>
    <Color x:Key="TextDark">#F2EFEA</Color>
    <Color x:Key="TextDimLight">#8C7A6B</Color>
    <Color x:Key="TextDimDark">#9A8E82</Color>

    <!-- Warm grays -->
    <Color x:Key="Gray100">#2A2622</Color>
    <Color x:Key="Gray200">#4D4842</Color>
    <Color x:Key="Gray300">#7A736A</Color>
    <Color x:Key="Gray400">#9C948A</Color>
    <Color x:Key="Gray500">#B8B0A6</Color>
    <Color x:Key="Gray600">#D6CFC6</Color>
    <Color x:Key="Gray900">#F0EBE4</Color>
    <Color x:Key="Gray950">#F8F5F0</Color>

    <!-- Contextual backgrounds -->
    <Color x:Key="BgWarmLight">#FFF6F0</Color>
    <Color x:Key="BgWarmDark">#1F1B17</Color>
    <Color x:Key="BgGreenLight">#F5FAF6</Color>
    <Color x:Key="BgGreenDark">#171B18</Color>

    <!-- Semantic -->
    <Color x:Key="Success">#2D9C5E</Color>
    <Color x:Key="Warning">#E8A317</Color>
    <Color x:Key="Error">#D45161</Color>
    <Color x:Key="Info">#5B8BA8</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF6F0" Offset="0.0" />
        <GradientStop Color="#FFFBF8" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF6B35" Offset="0.0" />
        <GradientStop Color="#E8A317" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
